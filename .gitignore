# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
backend/.venv/
backend/.git.uv-init-backup/

# Node
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/

# Environment and local state
.env
backend/.env
frontend/.env.local
*.local

# Editors / operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Local databases
backend/data/*.db
backend/data/*.db-*
backend/data/*.db.backup-*

# Local object storage runtime artifacts: demo uploads, generated report PDFs,
# research captures. These are outputs of running the app, not source.
#
# NOTE: .gitignore never untracks files already in the index. The historical demo
# assets already tracked under backend/data/assets stay tracked and keep working;
# new demo assets that should be versioned must be added explicitly with `git add -f`.
backend/data/assets/reports/
backend/data/assets/**/upload/
backend/data/assets/**/uploads/
backend/data/research/

# Agent / editor working memory. The four files already tracked
# (memory/MEMORY.md and the dated notes committed in the project snapshot)
# keep working; new dated notes are ignored by default. Note that a .gitignore
# rule never untracks a file already in the index.
.workbuddy/memory/2026-*.md
.impeccable/
