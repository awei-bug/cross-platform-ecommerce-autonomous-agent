# 应用
APP_NAME=运营中枢 API
APP_VERSION=0.2.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=please-change-in-production
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 持久化数据库（生产化模式）
POSTGRES_DB=ops_command_center
POSTGRES_USER=ops_admin
POSTGRES_PASSWORD=ops_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ops_admin:ops_dev_password@127.0.0.1:5432/ops_command_center
DATABASE_ECHO=false
DATABASE_AUTO_CREATE=false

# 异步任务：RabbitMQ broker + Redis result backend
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=amqp://ops_admin:ops_dev_password@127.0.0.1:5672//
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true
RABBITMQ_DEFAULT_USER=ops_admin
RABBITMQ_DEFAULT_PASS=ops_dev_password

# 淘宝开放平台（真实只读接入）
# 回调地址必须与淘宝开放平台后台登记地址完全一致。
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/taobao/callback
TAOBAO_AUTH_BASE_URL=https://oauth.taobao.com
TAOBAO_API_BASE_URL=https://eco.taobao.com/router/rest
TAOBAO_HTTP_TIMEOUT_SECONDS=10
TAOBAO_HTTP_MAX_ATTEMPTS=3
OAUTH_STATE_TTL_SECONDS=600
# 使用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成。
# 多密钥轮换时把新密钥放首位，旧密钥用逗号追加；禁止提交真实密钥。
TOKEN_ENCRYPTION_KEYS=

# 抖店开放平台（op.jinritemai.com）
# 抖店开放平台为开发者提供官方测试店铺，无需自有店铺即可拿到真实 access_token 联调：
# 控制台 -> 常用工具 -> 测试账号管理 复制授权 code，作为回调 code 传入 /integrations/douyin/callback。
DOUYIN_APP_KEY=
DOUYIN_APP_SECRET=
DOUYIN_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/douyin/callback
DOUYIN_AUTH_BASE_URL=https://openweb.douyin.com/platform/oauth/connect
DOUYIN_TOKEN_BASE_URL=https://openapi-fxg.jinritemai.com
DOUYIN_API_BASE_URL=https://openapi-fxg.jinritemai.com
DOUYIN_HTTP_TIMEOUT_SECONDS=10
DOUYIN_HTTP_MAX_ATTEMPTS=3

# 拼多多开放平台（open.pinduoduo.com）
# 注意：拼多多「商家自研系统」入驻要求已注册并通过审核的店铺，真实联调需要绑定可授权
# 店铺；个人开发者无店铺时只能完成代码与单元测试，无法拿到真实 access_token。
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/pinduoduo/callback
PDD_AUTH_BASE_URL=https://mms.pinduoduo.com/open.html
PDD_TOKEN_BASE_URL=https://open-api.pinduoduo.com/oauth/token
PDD_API_BASE_URL=https://gw-api.pinduoduo.com/api/router
PDD_HTTP_TIMEOUT_SECONDS=10
PDD_HTTP_MAX_ATTEMPTS=3

# 素材对象存储（已接入；本地可用 local，生产/多人环境可用 minio）
ASSET_STORAGE_BACKEND=minio
ASSET_STORAGE_LOCAL_PATH=./data/assets
ASSET_PREVIEW_EXPIRY_SECONDS=900
ASSET_UPLOAD_MAX_BYTES=26214400
MINIO_ROOT_USER=ops_admin
MINIO_ROOT_PASSWORD=ops_dev_password
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=ops-assets
MINIO_REGION=us-east-1

# 前端；留空时走 Vite /api 代理
VITE_API_BASE_URL=/api/v1
# Vite 开发代理目标；E2E 会覆盖为独立测试 API 端口。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
