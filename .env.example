# 应用
APP_NAME=运营中枢 API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 基础设施
POSTGRES_DB=ops_command_center
POSTGRES_USER=ops_admin
POSTGRES_PASSWORD=ops_dev_password
DATABASE_URL=postgresql+psycopg://ops_admin:ops_dev_password@127.0.0.1:5432/ops_command_center
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=amqp://ops_admin:ops_dev_password@127.0.0.1:5672//
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
MINIO_ROOT_USER=ops_admin
MINIO_ROOT_PASSWORD=ops_dev_password
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=ops-assets

# 前端；留空时走 Vite /api 代理
VITE_API_BASE_URL=/api/v1
